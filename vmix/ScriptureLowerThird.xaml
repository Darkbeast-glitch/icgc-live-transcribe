<Canvas xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1920" Height="1080" Background="Transparent">

  <!-- ================================================================
       ICGC FMT Live Word — Scripture lower third for vMix
       Data source: http://localhost:7788/current.xml   (XPath: /display)

       Field mapping (vMix Title editor → Data Source column):
         Reference    → reference     e.g. "John 3:16"
         Translation  → translation   e.g. "KJV"
         VerseText    → text          the verse body
       ================================================================ -->

  <!-- Backing panel. Sits inside the 5% broadcast-safe area. -->
  <Border Canvas.Left="140" Canvas.Top="742"
          Width="1640" Height="250"
          CornerRadius="10"
          Background="#E60E0E11"
          BorderBrush="#33333338" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="36" ShadowDepth="0" Opacity="0.65"/>
    </Border.Effect>
  </Border>

  <!-- Orange accent spine -->
  <Border Canvas.Left="140" Canvas.Top="742"
          Width="8" Height="250"
          CornerRadius="10,0,0,10"
          Background="#F97316"/>

  <!-- Reference — "John 3:16" -->
  <TextBlock x:Name="Reference"
             Canvas.Left="188" Canvas.Top="770"
             Width="1100"
             FontFamily="Segoe UI Semibold" FontSize="46"
             Foreground="#F97316"
             TextTrimming="CharacterEllipsis"
             Text="John 3:16">
    <TextBlock.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
    </TextBlock.Effect>
  </TextBlock>

  <!-- Translation badge — right aligned against the panel edge -->
  <TextBlock x:Name="Translation"
             Canvas.Left="1420" Canvas.Top="784"
             Width="320"
             TextAlignment="Right"
             FontFamily="Segoe UI" FontSize="28"
             Foreground="#94A3B8"
             Text="KJV"/>

  <!-- Verse body — wraps to a maximum of three lines at this size -->
  <TextBlock x:Name="VerseText"
             Canvas.Left="188" Canvas.Top="836"
             Width="1552"
             FontFamily="Segoe UI" FontSize="40"
             LineHeight="50" LineStackingStrategy="BlockLineHeight"
             Foreground="#FFFFFF"
             TextWrapping="Wrap"
             TextTrimming="CharacterEllipsis"
             Text="For God so loved the world, that he gave his only begotten Son, that whosoever believeth in him should not perish, but have everlasting life.">
    <TextBlock.Effect>
      <DropShadowEffect Color="#000000" BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
    </TextBlock.Effect>
  </TextBlock>

</Canvas>
